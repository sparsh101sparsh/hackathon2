{
  "name": "codeforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "verify:visualizers": "tsx scripts/verify-visualizers.ts",
    "ensure:visualizer-problems": "tsx scripts/ensure-visualizer-problems.ts",
    "verify:question-coverage": "tsx scripts/verify-question-coverage.ts",
    "check:freemodel-training": "tsx scripts/check-freemodel-training.ts",
    "generate:freemodel-knowledge": "tsx scripts/generate-freemodel-knowledge.ts",
    "submit:freemodel-training": "tsx scripts/submit-freemodel-training.ts",
    "build:freemodel-corpus": "tsx scripts/build-freemodel-corpus.ts",
    "reconcile:catalog": "tsx scripts/reconcile-catalog-integrity.ts",
    "normalize:corpus": "tsx scripts/normalize-explanation-headings.ts && tsx scripts/build-freemodel-corpus.ts",
    "test:input-boundaries": "tsx scripts/test-input-boundaries.ts",
    "test:provider-resilience": "tsx scripts/test-provider-resilience.ts",
    "test:rate-limits": "tsx scripts/test-rate-limits.ts",
    "test:health": "tsx scripts/test-health.ts",
    "test:interview-profiles": "tsx scripts/test-interview-profiles.ts",
    "test:visualizer-layout": "tsx scripts/test-visualizer-layout.ts",
    "test:revision-learning": "tsx scripts/test-revision-learning.ts",
    "verify:quality": "npm run lint && npx tsc --noEmit && npm run build && npm audit --audit-level=high && npm run verify:question-coverage && npx tsx scripts/test-challenger-m4.ts && npm run test:visualizer-layout && npm run test:revision-learning && npm run test:input-boundaries && npm run test:provider-resilience && npm run test:rate-limits && npm run test:interview-profiles && npx tsx scripts/test-public-boundaries.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "seed-real": "npx ts-node --project tsconfig.json scripts/seed-real-problems.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "dompurify": "^3.4.12",
    "minimatch": "^10.2.6",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "next": "^16.2.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.23",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
